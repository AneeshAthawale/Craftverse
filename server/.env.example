# CraftVerse backend environment template.
# Copy to .env and fill in real values. Never commit .env.

# Port the Express + Socket.IO server listens on.
PORT=5000

# PostgreSQL connection string.
# Local install example:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/craftverse

# Integration tests (npm test) run against this separate throwaway DB.
# It must be a DIFFERENT database from DATABASE_URL — tests reset its schema.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/craftverse_test

# Secret used to sign JWTs. Use a long random string in any non-local environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed origins for Socket.IO/CORS in development.
# Vite dev server default; the client also proxies /api so CORS rarely matters in dev.
CLIENT_ORIGIN=http://localhost:5173

# TTL (hours) for login tokens. Defaults to 12.
JWT_EXPIRES_IN=12h

# Anchor date (YYYY-MM-DD, server-local) of EVENT DAY 1. Food tokens are minted
# for event day 1 on this date and day 2 on the next day. Leave unset for dev
# (day 1 is assumed) — set it for any real event so meal windows land on the
# correct days.
# EVENT_DAY_ONE=2026-09-07
